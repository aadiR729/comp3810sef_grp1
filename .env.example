# Copy this file to .env and fill in your own values.
# `.env` is git-ignored, so real passwords never end up on GitHub.

# MongoDB connection string.
#   Local MongoDB:  mongodb://127.0.0.1:27017
#   MongoDB Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
# The database name is fixed to `library_db` in db/db.js.
MONGO_URI=mongodb://127.0.0.1:27017

# Port the web server listens on.
PORT=3000

# Secret used to sign the session cookie - change it to any random text.
SESSION_SECRET=change-me-to-something-random

# How long a member may keep a book (days). Defaults to 14.
LOAN_PERIOD_DAYS=14
